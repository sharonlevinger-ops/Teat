{
  "name": "cannabis-reviews",
  "version": "0.1.0",
  "private": true,
  "description": "קנאביס ביקורות – חיפוש זנים, פענוח תפריטי PDF ואיסוף ביקורות ממקורות ישראליים",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "setup": "npm install && npm --prefix web install",
    "dev": "concurrently -n server,web \"node --disable-warning=ExperimentalWarning --watch server/index.js\" \"npm --prefix web run dev\"",
    "build": "npm --prefix web run build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "scrape": "node --disable-warning=ExperimentalWarning server/scrape.js",
    "check-sources": "node --disable-warning=ExperimentalWarning server/scrape.js --check-only",
    "parse-menu": "node server/cli-parse-menu.js",
    "test": "node --disable-warning=ExperimentalWarning --test 'server/test/*.test.js'",
    "save-fixture": "node server/save-fixture.js"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.4.299",
    "robots-parser": "^3.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
